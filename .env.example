# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API). Use SOMENTE a chave pública.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Somente para o worker de servidor (workers/imports). Nunca no frontend nem no Git.
SUPABASE_SERVICE_ROLE_KEY=

# Somente para testes de banco locais
TEST_DATABASE_URL=postgres://gep:gep@localhost/gep_test
